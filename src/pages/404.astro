---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Not Found" description="Page not found">
  <div class="max-w-2xl mx-auto px-6 py-24 text-center">
    <p class="font-mono text-6xl font-bold mb-4" style="color: var(--color-border)">404</p>
    <h1 class="text-2xl font-semibold mb-3" style="color: var(--color-text)">Page not found</h1>
    <p class="text-base mb-8" style="color: var(--color-text-muted)">
      The page you're looking for doesn't exist or was moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm font-medium transition-colors"
    >
      ← Back to home
    </a>
  </div>
</BaseLayout>
