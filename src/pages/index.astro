---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout title="Home" description="Full-stack developer in Milan working on blockchain, backend, frontend, and coding-agent tooling.">
  <Hero />

  <!-- Featured projects -->
  <section class="max-w-5xl mx-auto px-6 pb-20">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl font-semibold" style="color: var(--color-text)">Recent work</h2>
      <a href="/projects" class="text-sm transition-colors hover:text-[var(--color-text)]" style="color: var(--color-text-muted)">
        All projects →
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {featuredProjects.map((project) => (
        <ProjectCard
          slug={project.id}
          title={project.data.title}
          description={project.data.description}
          date={project.data.date}
          tags={project.data.tags}
          links={project.data.links}
          featured={project.data.featured}
        />
      ))}
    </div>
  </section>

  <!-- Latest posts -->
  {latestPosts.length > 0 && (
    <section class="max-w-5xl mx-auto px-6 pb-20">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-xl font-semibold" style="color: var(--color-text)">Writing</h2>
        <a href="/blog" class="text-sm transition-colors hover:text-[var(--color-text)]" style="color: var(--color-text-muted)">
          All posts →
        </a>
      </div>
      <div class="flex flex-col gap-3">
        {latestPosts.map((post) => (
          <BlogPostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.id}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Contact -->
  <section class="max-w-5xl mx-auto px-6 pb-24">
    <div
      class="rounded-xl p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5"
      style="background: var(--color-bg-card); border: 1px solid var(--color-border); box-shadow: var(--shadow-soft)"
    >
      <div>
        <h2 class="text-xl font-semibold mb-1" style="color: var(--color-text)">Get in touch</h2>
        <p class="text-sm" style="color: var(--color-text-muted)">
          Email is the fastest way to reach me.
        </p>
      </div>
      <a
        href="mailto:francesco.moca@gmail.com"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium transition-colors self-start sm:self-auto"
        style="background: var(--color-accent); color: var(--color-on-accent)"
      >
        francesco.moca@gmail.com
      </a>
    </div>
  </section>
</BaseLayout>
