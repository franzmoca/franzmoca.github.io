---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Projects"
  description="Selected case studies across blockchain systems, machine learning experiments, mobile apps, and developer tooling."
>
  <div class="max-w-5xl mx-auto px-6 py-16">
    <header class="mb-12">
      <h1 class="text-3xl font-semibold mb-3" style="color: var(--color-text)">Projects</h1>
      <p class="text-base max-w-xl" style="color: var(--color-text-muted)">
        Case studies from the last few years: production-facing blockchain builds, university research,
        machine-learning experiments, and a few older mobile and web projects worth keeping around.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {sortedProjects.map((project) => (
        <ProjectCard
          slug={project.id}
          title={project.data.title}
          description={project.data.description}
          date={project.data.date}
          tags={project.data.tags}
          links={project.data.links}
          featured={project.data.featured}
        />
      ))}
    </div>
  </div>
</BaseLayout>
