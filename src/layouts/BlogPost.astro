---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
}

const { title, description, date, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <article class="max-w-2xl mx-auto px-6 py-16">
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4 text-sm" style="color: var(--color-text-muted)">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {tags.length > 0 && (
          <>
            <span>·</span>
            <div class="flex gap-2 flex-wrap">
              {tags.map((tag) => (
                <span class="px-2 py-0.5 rounded text-xs font-mono"
                  style="background: var(--color-bg-card); border: 1px solid var(--color-border)">
                  {tag}
                </span>
              ))}
            </div>
          </>
        )}
      </div>
      <h1 class="text-3xl font-semibold leading-tight" style="color: var(--color-text)">{title}</h1>
      {description && (
        <p class="mt-3 text-lg" style="color: var(--color-text-muted)">{description}</p>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .prose :global(h2) {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    color: var(--color-text);
  }
  .prose :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
    color: var(--color-text);
  }
  .prose :global(p) {
    margin: 0 0 1.25rem;
    color: var(--color-text);
    line-height: 1.75;
  }
  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--color-accent-hover);
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25rem 1.5rem;
    color: var(--color-text);
  }
  .prose :global(li) {
    margin-bottom: 0.4rem;
    line-height: 1.7;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: var(--color-accent);
  }
  .prose :global(pre) {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 0 0 1.5rem;
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-text);
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin: 0 0 1.25rem;
    color: var(--color-text-muted);
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-text);
  }
</style>
