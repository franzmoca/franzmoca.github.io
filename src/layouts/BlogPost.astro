---
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  ogImage?: string;
}

const { title, description, date, tags = [], ogImage } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <article class="max-w-2xl mx-auto px-6 py-16">
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4 text-sm" style="color: var(--color-text-muted)">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {tags.length > 0 && (
          <>
            <span>·</span>
            <span class="text-xs font-mono">{tags.join(' · ')}</span>
          </>
        )}
      </div>
      <h1 class="text-3xl font-semibold leading-tight" style="color: var(--color-text)">{title}</h1>
      {description && (
        <p class="mt-3 text-lg" style="color: var(--color-text-muted)">{description}</p>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
