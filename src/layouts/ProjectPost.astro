---
import BaseLayout from './BaseLayout.astro';
import { getProjectMedia } from '../data/projectMedia';
import ArrowOut from '../components/icons/ArrowOut.astro';
import '../styles/prose.css';

interface Link {
  label: string;
  url: string;
}

interface Props {
  slug: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  links?: Link[];
  ogImage?: string;
}

const { slug, title, description, date, tags = [], links = [], ogImage } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});
const media = getProjectMedia(slug);
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <a href="/projects" class="inline-flex items-center gap-2 text-sm mb-8 transition-colors link-muted">
      ← Back to projects
    </a>

    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4 text-sm" style="color: var(--color-text-muted)">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {tags.length > 0 && (
          <>
            <span>·</span>
            <div class="flex gap-2 flex-wrap">
              {tags.map((tag) => (
                <span class="px-2 py-0.5 rounded text-xs font-mono"
                  style="background: var(--color-bg-card); border: 1px solid var(--color-border); color: var(--color-text)">
                  {tag}
                </span>
              ))}
            </div>
          </>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl font-semibold leading-tight" style="color: var(--color-text)">{title}</h1>
      <p class="mt-3 text-lg max-w-2xl" style="color: var(--color-text-muted)">{description}</p>

      {links.length > 0 && (
        <div class="flex flex-wrap gap-3 mt-6">
          {links.map(({ label, url }) => (
            <a
              href={url}
              target={url.startsWith('http') ? '_blank' : undefined}
              rel={url.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-colors btn-secondary"
            >
              {label}
              <ArrowOut size={12} />
            </a>
          ))}
        </div>
      )}
    </header>

    {media && (
      <figure class="mb-10">
        <div
          class="overflow-hidden rounded-2xl"
          style="border: 1px solid var(--color-border); background: var(--color-bg-card); box-shadow: var(--shadow-soft)"
        >
          <img
            src={media.image.src}
            width={media.image.width}
            height={media.image.height}
            alt={media.alt}
            class="w-full h-auto object-cover"
          />
        </div>
      </figure>
    )}

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
