---
import propic from '../assets/propic.png';
---

<section class="max-w-5xl mx-auto px-6 py-16 sm:py-24">
  <div class="grid gap-10 lg:grid-cols-[1.45fr_0.95fr] lg:items-center">
    <div class="max-w-2xl">
      <p class="text-sm font-mono mb-4 tracking-wide uppercase" style="color: var(--color-accent)">
        Backend, frontend, smart contracts, DevOps
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold leading-tight mb-5" style="color: var(--color-text)">
        I build software end to end, from web apps and APIs to smart contracts and infrastructure.
      </h1>
      <p class="text-lg sm:text-xl leading-relaxed mb-8" style="color: var(--color-text-muted)">
        I’m Francesco Moca, a Milan-based full-stack developer and IT consultant working across backend,
        frontend, smart contracts, and DevOps. I build and deliver software in enterprise contexts, with responsibility
        often spanning implementation, team coordination, and project execution.
      </p>

      <div class="flex flex-wrap items-center gap-3 mb-8">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium transition-colors"
          style="background: var(--color-accent); color: #020617"
        >
          Selected work
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
          </svg>
        </a>
        <a
          href="/about"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium transition-colors"
          style="background: var(--color-bg-card); border: 1px solid var(--color-border); color: var(--color-text)"
        >
          About me
        </a>
        <a
          href="mailto:francesco.moca@gmail.com"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium transition-colors"
          style="background: transparent; border: 1px solid var(--color-border); color: var(--color-text-muted)"
        >
          Email
        </a>
      </div>

      <div class="flex flex-wrap gap-2 mb-8">
        {['5+ years enterprise delivery', 'Solidity / Go / Java / TypeScript', 'AWS + Kubernetes', 'LLMs, specs, automation'].map((item) => (
          <span
            class="text-xs sm:text-sm px-3 py-1.5 rounded-full font-mono"
            style="background: var(--color-bg-card); border: 1px solid var(--color-border); color: var(--color-text-muted)"
          >
            {item}
          </span>
        ))}
      </div>

      <div class="flex flex-wrap items-center gap-5">
        <a
          href="https://github.com/franzmoca"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium transition-colors flex items-center gap-2"
          style="color: var(--color-text-muted)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
            fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/francesco-moca-69001a121/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium transition-colors flex items-center gap-2"
          style="color: var(--color-text-muted)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
            fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
        <a
          href="/cv"
          class="text-sm font-medium transition-colors flex items-center gap-2"
          style="color: var(--color-text-muted)"
        >
          CV
        </a>
      </div>
    </div>

    <div class="justify-self-start lg:justify-self-end w-full max-w-sm">
      <div
        class="rounded-[28px] p-4 sm:p-5"
        style="background: linear-gradient(180deg, rgba(14, 23, 43, 0.95), rgba(9, 15, 31, 0.95)); border: 1px solid var(--color-border); box-shadow: var(--shadow-soft)"
      >
        <img
          src={propic.src}
          width={propic.width}
          height={propic.height}
          alt="Portrait of Francesco Moca"
          class="w-full h-auto rounded-[22px] object-cover mb-4"
          style="background: #111827"
        />
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-2xl p-3" style="background: rgba(15, 23, 42, 0.72); border: 1px solid var(--color-border)">
            <p class="text-xs font-mono mb-1" style="color: var(--color-text-muted)">Current focus</p>
            <p class="text-sm font-medium" style="color: var(--color-text)">Blockchain systems + LLM tools</p>
          </div>
          <div class="rounded-2xl p-3" style="background: rgba(15, 23, 42, 0.72); border: 1px solid var(--color-border)">
            <p class="text-xs font-mono mb-1" style="color: var(--color-text-muted)">Based in</p>
            <p class="text-sm font-medium" style="color: var(--color-text)">Milan, Italy</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
