---
import { getProjectMedia } from '../data/projectMedia';
import ArrowOut from './icons/ArrowOut.astro';

interface Link {
  label: string;
  url: string;
}

interface Props {
  slug: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  links?: Link[];
  featured?: boolean;
}

const { slug, title, description, date, tags = [], links = [] } = Astro.props;

const year = date.getFullYear();
const media = getProjectMedia(slug);
---

<article class="rounded-xl p-5 flex flex-col gap-3 card surface-card">
  {media && (
    <a
      href={`/projects/${slug}`}
      class="block overflow-hidden rounded-lg mb-1"
      style="border: 1px solid var(--color-border); background: var(--color-bg-card)"
    >
      <img
        src={media.image.src}
        width={media.image.width}
        height={media.image.height}
        alt={media.alt}
        class="w-full h-auto aspect-[16/9] object-cover"
        loading="lazy"
      />
    </a>
  )}

  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold text-base leading-snug" style="color: var(--color-text)">
      <a href={`/projects/${slug}`} class="text-inherit transition-colors hover:text-accent-strong">
        {title}
      </a>
    </h3>
    <span class="text-xs shrink-0 mt-0.5 font-mono" style="color: var(--color-text-muted)">{year}</span>
  </div>

  <p class="text-sm leading-relaxed" style="color: var(--color-text-muted)">{description}</p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span
          class="text-xs px-2 py-0.5 rounded font-mono"
          style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text)"
        >
          {tag}
        </span>
      ))}
    </div>
  )}

  <div class="flex flex-wrap gap-4 mt-auto pt-2 items-center">
    <a
      href={`/projects/${slug}`}
      class="text-xs font-medium flex items-center gap-1 transition-colors"
    >
      Read more
      <span aria-hidden="true">→</span>
    </a>

    {links.length > 0 && (
      <>
      {links.map(({ label, url }) => (
        <a
          href={url}
          target={url.startsWith('http') ? '_blank' : undefined}
          rel={url.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="text-xs font-medium flex items-center gap-1 transition-colors link-muted"
        >
          {label}
          <ArrowOut size={11} />
        </a>
      ))}
      </>
    )}
  </div>
</article>
