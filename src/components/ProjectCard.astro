---
interface Link {
  label: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  links?: Link[];
  featured?: boolean;
}

const { title, description, date, tags = [], links = [] } = Astro.props;

const year = date.getFullYear();
---

<article
  class="rounded-xl p-5 flex flex-col gap-3 transition-colors"
  style="background: var(--color-bg-card); border: 1px solid var(--color-border)"
>
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold text-base leading-snug" style="color: var(--color-text)">{title}</h3>
    <span class="text-xs shrink-0 mt-0.5 font-mono" style="color: var(--color-text-muted)">{year}</span>
  </div>

  <p class="text-sm leading-relaxed" style="color: var(--color-text-muted)">{description}</p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span
          class="text-xs px-2 py-0.5 rounded font-mono"
          style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text-muted)"
        >
          {tag}
        </span>
      ))}
    </div>
  )}

  {links.length > 0 && (
    <div class="flex gap-4 mt-auto pt-1">
      {links.map(({ label, url }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-medium flex items-center gap-1 transition-colors"
          style="color: var(--color-accent)"
        >
          {label}
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
          </svg>
        </a>
      ))}
    </div>
  )}
</article>
