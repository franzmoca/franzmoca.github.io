---
import GitHub from './icons/GitHub.astro';
import LinkedIn from './icons/LinkedIn.astro';
import Email from './icons/Email.astro';

const year = new Date().getFullYear();
---

<footer class="mt-20" style="border-top: 1px solid var(--color-border)">
  <div class="max-w-5xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm" style="color: var(--color-text-muted)">
      &copy; {year} Francesco Moca &mdash; Milan, Italy
    </p>
    <div class="flex items-center gap-5">
      <a
        href="https://github.com/franzmoca"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm transition-colors hover:text-[var(--color-text)]"
        style="color: var(--color-text-muted)"
        aria-label="GitHub"
      >
        <GitHub />
      </a>
      <a
        href="https://www.linkedin.com/in/francesco-moca-69001a121/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm transition-colors hover:text-[var(--color-text)]"
        style="color: var(--color-text-muted)"
        aria-label="LinkedIn"
      >
        <LinkedIn />
      </a>
      <a
        href="mailto:francesco.moca@gmail.com"
        class="text-sm transition-colors hover:text-[var(--color-text)]"
        style="color: var(--color-text-muted)"
        aria-label="Email"
      >
        <Email />
      </a>
    </div>
  </div>
</footer>
