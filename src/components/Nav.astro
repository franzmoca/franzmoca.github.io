---
import Menu from './icons/Menu.astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<header style="border-bottom: 1px solid var(--color-border); background: var(--color-nav-surface); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px)" class="sticky top-0 z-50">
  <nav class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="/" class="font-mono text-sm font-medium" style="color: var(--color-text)">
      fm<span style="color: var(--color-accent-strong)">.</span>
    </a>

    <div class="hidden sm:flex items-center gap-6">
      <ul class="flex items-center gap-6 list-none m-0 p-0">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={['text-sm transition-colors', isActive(href) ? 'text-text' : 'link-muted']}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href="/cv"
        class="inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium transition-colors btn-secondary"
        aria-current={isActive('/cv') ? 'page' : undefined}
      >
        CV
      </a>
    </div>

    <!-- Mobile nav -->
    <details class="sm:hidden relative">
      <summary class="cursor-pointer list-none p-1" style="color: var(--color-text-muted)"
        aria-label="Open navigation menu">
        <Menu size={20} />
      </summary>
      <ul class="absolute right-0 top-9 w-44 rounded-lg py-1 list-none m-0 z-50"
        style="background: var(--color-menu-surface); border: 1px solid var(--color-border); box-shadow: var(--shadow-soft)">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={['block px-4 py-2 text-sm transition-colors', isActive(href) ? 'text-text' : 'link-muted']}
              style={isActive(href) ? 'background: var(--color-bg-hover)' : undefined}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
        <li style="border-top: 1px solid var(--color-border); margin-top: 4px; padding-top: 4px">
          <a
            href="/cv"
            class="block px-4 py-2 text-sm transition-colors text-text"
            style={isActive('/cv') ? 'background: var(--color-bg-hover)' : undefined}
            aria-current={isActive('/cv') ? 'page' : undefined}
          >
            CV
          </a>
        </li>
      </ul>
    </details>
  </nav>
</header>
