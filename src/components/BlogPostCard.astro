---
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
}

const { title, description, date, slug, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={`/blog/${slug}`}
  class="block rounded-xl p-5 card surface-card group"
>
  <div class="flex items-start justify-between gap-3 mb-2">
    <h3
      class="font-semibold text-base leading-snug transition-colors text-text group-hover:text-accent-strong"
    >
      {title}
    </h3>
    <time
      datetime={date.toISOString()}
      class="text-xs shrink-0 mt-0.5 font-mono"
      style="color: var(--color-text-muted)"
    >
      {formattedDate}
    </time>
  </div>

  <p class="text-sm leading-relaxed mb-3" style="color: var(--color-text-muted)">{description}</p>

  {tags.length > 0 && (
    <p class="text-xs font-mono" style="color: var(--color-text-muted)">{tags.join(' · ')}</p>
  )}
</a>
